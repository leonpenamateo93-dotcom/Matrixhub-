-- Slider centrado, con hitbox grande y soporte táctil.
local function addSlider(title, minimum, maximum, initial, callback)
    local container = make("Frame", {
        Size = UDim2.new(1, -4, 0, 62),
        BackgroundTransparency = 1,
    }, content)

    local label = make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 25),
        BackgroundTransparency = 1,
        Text = title .. ": " .. tostring(initial),
        TextColor3 = WHITE,
        Font = Enum.Font.Code,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, container)

    local track = make("Frame", {
        Size = UDim2.new(1, -12, 0, 8),
        Position = UDim2.new(0, 6, 0, 40),
        BackgroundColor3 = Color3.fromRGB(55, 65, 60),
        BorderSizePixel = 0,
    }, container)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, track)

    local fill = make("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = GREEN,
        BorderSizePixel = 0,
    }, track)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)

    local knob = make("Frame", {
        Size = UDim2.fromOffset(16, 16),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0,
    }, track)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)

    local hitbox = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        Position = UDim2.new(0, 0, 0, 26),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, container)

    local value = math.clamp(initial, minimum, maximum)
    local dragging = false
    local activeTouch

    local function update(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end

        local alpha = math.clamp(
            (x - track.AbsolutePosition.X) / width,
            0, 1
        )
        value = math.floor(minimum + alpha * (maximum - minimum) + 0.5)
        alpha = (value - minimum) / (maximum - minimum)

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        label.Text = title .. ": " .. tostring(value)
        callback(value)
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position.X)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            activeTouch = input
            update(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        elseif input.UserInputType == Enum.UserInputType.Touch
            and activeTouch == input then
            update(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or (input.UserInputType == Enum.UserInputType.Touch
                and activeTouch == input) then
            dragging = false
            activeTouch = nil
        end
    end)

    update(track.AbsolutePosition.X
        + track.AbsoluteSize.X * ((initial - minimum) / (maximum - minimum)))

    return container
end

