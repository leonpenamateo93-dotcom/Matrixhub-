local function makeDraggable(object, onTap)
    local dragging = false
    local moved = false
    local startPos
    local objectPos
    local activeTouch

    object.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            startPos = input.Position
            objectPos = object.Position
            if input.UserInputType == Enum.UserInputType.Touch then
                activeTouch = input
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or (input.UserInputType == Enum.UserInputType.Touch
                and activeTouch == input) then
            local delta = input.Position - startPos
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
                moved = true
            end
            object.Position = UDim2.new(
                objectPos.X.Scale, objectPos.X.Offset + delta.X,
                objectPos.Y.Scale, objectPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or (input.UserInputType == Enum.UserInputType.Touch
                and activeTouch == input) then
            local wasTap = dragging and not moved
            dragging = false
            activeTouch = nil
            if wasTap then onTap() end
        end
    end)
end

