local function CreateESP(player)
    if player == LocalPlayer then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = player.Name
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 120, 0, 45)
    billboard.Adornee = nil
    billboard.Enabled = false
    billboard.Parent = espFolder

    local tagLabel = Instance.new("TextLabel")
    tagLabel.Size = UDim2.new(1, 0, 0, 15)
    tagLabel.Position = UDim2.new(0, 0, 0, 0)
    tagLabel.BackgroundTransparency = 1
    tagLabel.Text = Config.ESP.TagText
    tagLabel.TextColor3 = Config.ESP.Color
    tagLabel.Font = Enum.Font.Code
    tagLabel.TextSize = 12
    tagLabel.Parent = billboard

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1, 0, 0, 25)
    infoLabel.Position = UDim2.new(0, 0, 0, 15)
    infoLabel.BackgroundTransparency = 1
    infoLabel.Text = player.DisplayName .. "\n[0m]"
    infoLabel.TextColor3 = Config.ESP.Color
    infoLabel.Font = Enum.Font.Code
    infoLabel.TextSize = 11
    infoLabel.Parent = billboard

    local function UpdateAdornee()
        if player.Character and player.Character:FindFirstChild("Head") then
            billboard.Adornee = player.Character.Head
        else
            billboard.Adornee = nil
        end
    end

    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        UpdateAdornee()
    end)
    UpdateAdornee()
end

for _, p in pairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)

Players.PlayerRemoving:Connect(function(p)
    local b = espFolder:FindFirstChild(p.Name)
