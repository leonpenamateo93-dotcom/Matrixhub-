-- 4. TRACERS (LÍNEAS DIBUJADAS)
-- --------------------------------------------------------------------
local tracerFolder = Instance.new("Folder")
tracerFolder.Name = "Tracers_Storage"
tracerFolder.Parent = ScreenGui

RunService.RenderStepped:Connect(function()
    if not Config.Tracers.Enabled then
        tracerFolder:ClearAllChildren()
        return
    end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hrpPos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            local line = tracerFolder:FindFirstChild(p.Name)

            if onScreen then
                if not line then
                    line = Instance.new("Frame")
                    line.Name = p.Name
                    line.AnchorPoint = Vector2.new(0.5, 0.5)
                    line.BorderSizePixel = 0
                    line.BackgroundColor3 = Config.Tracers.Color
                    line.Parent = tracerFolder
                end

                local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                local endPos = Vector2.new(hrpPos.X, hrpPos.Y)
                local distance = (endPos - startPos).Magnitude
                local angle = math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X)

                line.Size = UDim2.new(0, distance, 0, 1.5)
                line.Position = UDim2.new(0, (startPos.X + endPos.X) / 2, 0, (startPos.Y + endPos.Y) / 2)
                line.Rotation = math.deg(angle)
            else
                if line then line:Destroy() end
            end
        end
    end
end)

CreateToggle(PageTracers, "Activar Tracers", function(state)
    Config.Tracers.Enabled = state
    if not state then tracerFolder:ClearAllChildren() end
end)

